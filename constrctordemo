	ConExample(){// constructor
	System.out.println("default con");	
	}
	ConExample(int a,String b){
		System.out.println("2 parameter");
	}
	ConExample(int r){
		System.out.println("1 para");
	}
	ConExample(int s, int b,int d){
		System.out.println("3 para");
	}
